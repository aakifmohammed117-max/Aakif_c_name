#include <stdio.h>


void main()
{
    FILE *fp;
    char name[300];

    //clrscr();

    // 1. Writing data into file
    fp = fopen("student.txt", "w");

    if (fp == NULL)
    {
        printf("File cannot be opened");
    
        return;
    }

    fprintf(fp, " The C programming class helped me understand the basics of programming and problem-solving");

    fclose(fp);

    printf("Data written successfully\n");


    // 2. Appending data into file
    fp = fopen("student.txt", "a");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    fprintf(fp, "\nThe concepts were explained clearly with practical examples.");

    fclose(fp);

    printf("Data appended successfully\n");


    // 3. Reading data from file
    fp = fopen("student.txt", "r");

    if (fp == NULL)
    {
        printf("File cannot be opened");
        
        return;
    }

    printf("\nFile Contents:\n");

    while (fgets(name, sizeof(name), fp) != NULL)
    {
        printf("%s", name);
    }

    fclose(fp);


}